{
    "name": "acencyril/uplift-bundle",
    "type": "symfony-bundle",
    "description": "Dependency upgrades with guardrails for Symfony projects: PHP, Symfony and packages move as far as your policy allows, under a PHP ceiling, then the tests decide. Never pushes, never deploys.",
    "keywords": [
        "symfony",
        "composer",
        "upgrade",
        "dependencies",
        "maintenance",
        "php-version",
        "rector"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cyril",
            "homepage": "https://github.com/acencyril"
        }
    ],
    "require": {
        "php": ">=8.1",
        "nikic/php-parser": "^5.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Acencyril\\UpliftBundle\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Acencyril\\UpliftBundle\\Tests\\": "tests/"
        }
    }
}

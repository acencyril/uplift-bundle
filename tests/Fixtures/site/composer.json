{
    "name": "example/site",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "acencyril/sentinelle-bundle": "^0.3",
        "doctrine/orm": "^3.3",
        "symfony/console": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*"
    },
    "config": {
        "platform": {
            "php": "8.3.12"
        },
        "sort-packages": true
    },
    "replace": {
        "symfony/polyfill-ctype": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "scripts": {},
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
